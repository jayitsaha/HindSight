# Copy to .env and fill in. .env is gitignored.
# Comma-separated NVIDIA NIM keys. One works fine; several lets the client
# rotate past per-key rate limits.
NVIDIA_API_KEYS=nvapi-xxxxxxxx,nvapi-yyyyyyyy

HINDSIGHT_PROVIDER=auto
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EMBED_MODEL=nvidia/nvclip
NIM_VLM_MODEL=meta/llama-3.2-90b-vision-instruct
NIM_GROUNDER_MODEL=microsoft/kosmos-2
